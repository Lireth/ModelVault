# 依赖
node_modules/

# 构建产物
out/
dist/

# 日志
logs/
*.log

# 环境变量本地文件（Vite 约定，可能含敏感配置）
.env.local
.env.*.local

# 编辑器与系统文件
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
$RECYCLE.BIN/

# 其他
.trae/
docs/
tmp/
test/
coverage/
.screenshots/

# 注意：build/（应用图标）、electron-builder.yml（打包配置）与 .npmrc
# （registry，lock resolved 与其一致）必须入库，否则干净环境下构建/发布
# 流水线不可复现；Electron 二进制镜像已迁移为环境变量（O2：CI job 级 env
# 注入 ELECTRON_MIRROR / ELECTRON_BUILDER_BINARIES_MIRROR，本地见 README）
