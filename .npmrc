# 国内镜像：registry 供 npm 使用；electron_mirror /
# electron_builder_binaries_mirror 由 Electron 的安装脚本与 electron-builder
# 读取，不属于 npm 项目配置——npm 11+ 会打印 “Unknown project config” 警告，
# 属预期现象且当前版本仍生效。若需彻底消除告警，可删除这两行，并在 shell/CI
# 设置环境变量 ELECTRON_MIRROR / ELECTRON_BUILDER_BINARIES_MIRROR（值与下同）。
registry=https://registry.npmmirror.com
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
