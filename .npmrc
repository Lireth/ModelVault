# 国内镜像：registry 供 npm 使用（package-lock 的 resolved 与其一致，必须入库）。
# Electron / electron-builder 的二进制镜像不在本文件配置——electron_mirror /
# electron_builder_binaries_mirror 不属于 npm 项目配置键（npm 11+ 会对
# .npmrc 中的未知键打印 “Unknown project config” 告警），统一改用环境变量
# ELECTRON_MIRROR / ELECTRON_BUILDER_BINARIES_MIRROR：CI 两个工作流已在
# job 级 env 注入；本地开发者按 README「快速开始」提示自行设置。
registry=https://registry.npmmirror.com
